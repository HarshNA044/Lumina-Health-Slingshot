{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "goals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dietaryPreferences": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Meal": {
      "title": "Meal",
      "description": "A logged meal with AI analysis",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "calories": { "type": "number" },
        "macronutrients": {
          "type": "object",
          "properties": {
            "protein": { "type": "number" },
            "carbs": { "type": "number" },
            "fat": { "type": "number" }
          }
        },
        "healthScore": { "type": "number" },
        "analysis": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "timestamp"]
    },
    "Habit": {
      "title": "Habit",
      "description": "A healthy habit the user is tracking",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "frequency": { "type": "string", "enum": ["daily", "weekly"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "frequency", "active"]
    },
    "HabitLog": {
      "title": "Habit Log",
      "description": "A daily log of habit completion",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "habitId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "completed": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "habitId", "date", "completed"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/meals/{mealId}": {
      "schema": "Meal",
      "description": "Meal logs"
    },
    "/habits/{habitId}": {
      "schema": "Habit",
      "description": "Tracked habits"
    },
    "/habitLogs/{logId}": {
      "schema": "HabitLog",
      "description": "Log of habit completions"
    }
  }
}
